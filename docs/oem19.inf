;---------------- CtHdb configuration

[HDABusFilter.NT]
Include=hdaudbus.inf
Needs=HDAudio_Device.NT
CopyFiles=HDBCopyList

[HDBCopyList]
CtxHdb.sys

[HDABusFilter.NT.HW]
AddReg=HDABusFilter.AddReg,SetupCodec.AddReg

[HDABusFilter.AddReg]
HKR,,"LowerFilters",0x00010000,"CtxHdb"

[HDABusFilter.NT.Services]
Needs=HDAudio_Device.NT.Services
AddService=CtxHdb,,CTHDAudio_Service_Inst
;DelService = CtxHdb, 0x00000200

[CTHDAudio_Service_Inst]
DisplayName=%Creative.CTHDBDesc%
ServiceType=1                   ; SERVICE_KERNEL_DRIVER
StartType=3                     ; SERVICE_DEMAND_START
ErrorControl=1                  ; SERVICE_ERROR_NORMAL
ServiceBinary=%12%\Ctxhdb.sys

[SetupCodec.AddReg]
;Setup CodecType
HKLM,%CtHdbKey%\CodecConfig,CodecType_11020051,,"XAE5"
HKLM,%CtHdbKey%\CodecConfig,CodecType_11020061,,"XAE3"
HKLM,%CtHdbKey%\CodecConfig,CodecType_11020071,,"XAE9"
HKLM,%CtHdbKey%\CodecConfig,CodecType_11020073,,"XAE9PE"
HKLM,%CtHdbKey%\CodecConfig,CodecType_11020081,,"XAE7"
HKLM,%CtHdbKey%\CodecConfig,CodecType_11020191,,"XAE5PLUS"
;Driver Key
HKLM,%CtHdaKey%,,0x00000010,

;---------------- MS HDAudio configuration
[MSHDAudio]
Include=hdaudio.inf
Needs=HdAudModel

[MSHDAudio.HW]
Include=hdaudio.inf
Needs=HdAudModel.HW

[MSHDAudio.Services]
Include=hdaudio.inf
Needs=HdAudModel.Services

[MSHDAudio.Interfaces]
;SpdifOut
AddInterface=%KSCATEGORY_AUDIO%,        eSpdifOutWave,      MSHDAudio.Interface.SpdifOutWave
AddInterface=%KSCATEGORY_RENDER%,       eSpdifOutWave,      MSHDAudio.Interface.SpdifOutWave
AddInterface=%KSCATEGORY_REALTIME%,     eSpdifOutWave,      MSHDAudio.Interface.SpdifOutWave
AddInterface=%KSCATEGORY_AUDIO%,        eSpdifOutTopo,      MSHDAudio.Interface.SpdifOutTopo
AddInterface=%KSCATEGORY_TOPOLOGY%,     eSpdifOutTopo,      MSHDAudio.Interface.SpdifOutTopo
;SpdifIn
AddInterface=%KSCATEGORY_AUDIO%,        eSpdifInWave,       MSHDAudio.Interface.SpdifInWave
AddInterface=%KSCATEGORY_CAPTURE%,      eSpdifInWave,       MSHDAudio.Interface.SpdifInWave
AddInterface=%KSCATEGORY_REALTIME%,     eSpdifInWave,       MSHDAudio.Interface.SpdifInWave
AddInterface=%KSCATEGORY_AUDIO%,        eSpdifInTopo,       MSHDAudio.Interface.SpdifInTopo
AddInterface=%KSCATEGORY_TOPOLOGY%,     eSpdifInTopo,       MSHDAudio.Interface.SpdifInTopo
;AuxIn
AddInterface=%KSCATEGORY_AUDIO%,        eAuxInWave,         MSHDAudio.Interface.AuxWave
AddInterface=%KSCATEGORY_CAPTURE%,      eAuxInWave,         MSHDAudio.Interface.AuxWave
AddInterface=%KSCATEGORY_REALTIME%,     eAuxInWave,         MSHDAudio.Interface.AuxWave
AddInterface=%KSCATEGORY_AUDIO%,        eAuxInTopo,         MSHDAudio.Interface.AuxTopo
AddInterface=%KSCATEGORY_TOPOLOGY%,     eAuxInTopo,         MSHDAudio.Interface.AuxTopo
;LineIn
AddInterface=%KSCATEGORY_AUDIO%,        eLineInWave,        MSHDAudio.Interface.LineInWave
AddInterface=%KSCATEGORY_CAPTURE%,      eLineInWave,        MSHDAudio.Interface.LineInWave
AddInterface=%KSCATEGORY_REALTIME%,     eLineInWave,        MSHDAudio.Interface.LineInWave
AddInterface=%KSCATEGORY_AUDIO%,        eLineInTopo,        MSHDAudio.Interface.LineInTopo
AddInterface=%KSCATEGORY_TOPOLOGY%,     eLineInTopo,        MSHDAudio.Interface.LineInTopo

[MSHDAudio.Interface.SpdifOutWave]
AddReg = MSHDAudio.Interface.SpdifOutWave.AddReg
[MSHDAudio.Interface.SpdifOutWave.AddReg]
HKR,,FriendlyName,,%DigitalOutWaveName%
HKR,,CLSID,,%Proxy.CLSID%

[MSHDAudio.Interface.SpdifOutTopo]
AddReg = MSHDAudio.Interface.SpdifOutTopo.AddReg,EPConfig.AddReg
[MSHDAudio.Interface.SpdifOutTopo.AddReg]
HKR,,FriendlyName,,%DigitalOutTopoName%
HKR,,CLSID,,%Proxy.CLSID%

[MSHDAudio.Interface.SpdifInWave]
AddReg = MSHDAudio.Interface.SpdifInWave.AddReg
[MSHDAudio.Interface.SpdifInWave.AddReg]
HKR,,FriendlyName,,%DigitalInWaveName%
HKR,,CLSID,,%Proxy.CLSID%

[MSHDAudio.Interface.SpdifInTopo]
AddReg = MSHDAudio.Interface.SpdifInTopo.AddReg,EPConfig.AddReg
[MSHDAudio.Interface.SpdifInTopo.AddReg]
HKR,,FriendlyName,,%DigitalInTopoName%
HKR,,CLSID,,%Proxy.CLSID%

[MSHDAudio.Interface.LineInWave]
AddReg = MSHDAudio.Interface.LineInWave.AddReg
[MSHDAudio.Interface.LineInWave.AddReg]
HKR,,FriendlyName,,%AuxWaveName%
HKR,,CLSID,,%Proxy.CLSID%

[MSHDAudio.Interface.LineInTopo]
AddReg = MSHDAudio.Interface.LineInTopo.AddReg,EPConfig.AddReg
[MSHDAudio.Interface.LineInTopo.AddReg]
HKR,,FriendlyName,,%AuxTopoName%
HKR,,CLSID,,%Proxy.CLSID%
HKR,"EP\\0",%PKEY_AudioEndpoint_Icon%,,"%%SystemRoot%%\system32\mmres.dll,3"
HKR,"EP\\0",%PKEY_AudioEndpoint_Name%,,"Aux"
HKR,"EP\\0",%PKEY_CT_LINETOAUX_GUID%,0x00010001,0x00000001

[MSHDAudio.Interface.AuxWave]
AddReg = MSHDAudio.Interface.AuxWave.AddReg
[MSHDAudio.Interface.AuxWave.AddReg]
HKR,,FriendlyName,,%AuxWaveName%
HKR,,CLSID,,%Proxy.CLSID%

[MSHDAudio.Interface.AuxTopo]
AddReg = MSHDAudio.Interface.AuxTopo.AddReg,EPConfig.AddReg
[MSHDAudio.Interface.AuxTopo.AddReg]
HKR,,FriendlyName,,%AuxTopoName%
HKR,,CLSID,,%Proxy.CLSID%
HKR,"EP\\0",%PKEY_AudioEndpoint_Icon%,,"%%SystemRoot%%\system32\mmres.dll,3"
HKR,"EP\\0",%PKEY_AudioDevice_EnableEndpointByDefault%,0x00010001,0x00000201


;---------------- SoundCore3D configuration

[SoundCore3D.NTX86]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=SysFiles.CopyList.ntx86,DLL.CopyList.ntx86,EXE.CopyList.ntx86,APO.CopyList.ntx86,CoInst.CopyList.ntx86,LangFile.CopyList.ntx86
AddReg=SoundCore3D.AddReg, PinConfig.AddReg, CodecConfig.AddReg, DriverSettings.AddReg, CoInst.AddReg.ntx86
AddProperty=SoundCore3D.AddProperty
RegisterDlls=SoundCore3D.NTX86.RegisterDlls

[SoundCore3D.NTAMD64]
Include=ks.inf, wdmaudio.inf
Needs=KS.Registration, WDMAUDIO.Registration
CopyFiles=SysFiles.CopyList.amd64,DLL.CopyList.amd64,DLL.CopyList.thunk,EXE.CopyList.amd64,APO.CopyList.amd64,CoInst.CopyList.amd64,LangFile.CopyList.amd64
AddReg=SoundCore3D.AddReg, PinConfig.AddReg, CodecConfig.AddReg, DriverSettings.AddReg, CoInst.AddReg.amd64
AddProperty=SoundCore3D.AddProperty
RegisterDlls=SoundCore3D.NTAMD64.RegisterDlls

[SoundCore3D.AddProperty]
DeviceVendorWebSite,,,,"http://www.creative.com"

[SoundCore3D.NTX86.HW]
AddReg=Security.AddReg

[SoundCore3D.NTAMD64.HW]
AddReg=Security.AddReg

[Security.AddReg]
; FILE_DEVICE_SOUND
HKR,,DeviceType,0x10001,0x0000001D
; SDDL_DEVOBJ_SYS_ALL_ADM_RWX_WORLD_RWX_RES_RWX
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[SoundCore3D.NTX86.CoInstallers]
CopyFiles=CoInst.CopyList.ntx86
AddReg=CoInst.AddReg.ntx86

[SoundCore3D.NTAMD64.CoInstallers]
CopyFiles=CoInst.CopyList.amd64
AddReg=CoInst.AddReg.amd64

[CoInst.AddReg.ntx86]
HKR,,CoInstallers32,0x00010000,"CtxDco32.dll,CtDevCoInstProc"
HKR,,OriginalSourcePath,,%01%
HKLM,%CoInstallerInfo%,%DvCoInstall32Name%,,%DvININame%

[CoInst.AddReg.amd64]
HKR,,CoInstallers32,0x00010000,"CtxDco64.dll,CtDevCoInstProc"
HKR,,OriginalSourcePath,,%01%
HKLM,%CoInstallerInfo%,%DvCoInstall64Name%,,%DvININame%

[SoundCore3D.NTX86.Interfaces]
;;Speaker
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_SpeakerWave%,        SoundCore3D.Interface.SpeakerWave
AddInterface=%KSCATEGORY_RENDER%,   %KSNAME_SpeakerWave%,        SoundCore3D.Interface.SpeakerWave
AddInterface=%KSCATEGORY_REALTIME%, %KSNAME_SpeakerWave%,        SoundCore3D.Interface.SpeakerWave
AddInterface=%KSCATEGORY_AUDIO%,    %KSNAME_SpeakerTopo%,        SoundCore3D.Interface.SpeakerTopo
AddInterface=%KSCATEGORY_TOPOLOGY%, %KSNAME_SpeakerTopo%,        SoundCore3D.Interface.SpeakerTopo

